{
  "name": "tipidbuddy",
  "version": "1.0.0",
  "description": "React Native grocery shopping list and budget tracking app",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "start:lan": "expo start --lan --go --clear",
    "start:tunnel": "expo start --tunnel --go --clear",
    "start:dev": "expo start --dev-client",
    "android": "expo start --dev-client --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "type-check": "tsc --noEmit",
    "lint": "eslint src/**/*.{ts,tsx}",
    "format": "prettier --write src/**/*.{ts,tsx,json}",
    "eject": "expo eject"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-ml-kit/text-recognition": "^2.0.0",
    "@react-navigation/bottom-tabs": "^7.18.18",
    "@react-navigation/native": "^7.3.18",
    "@react-navigation/stack": "^7.10.24",
    "dotenv": "^18.0.10",
    "expo": "^58.0.24",
    "expo-build-properties": "~58.0.12",
    "expo-camera": "~58.0.14",
    "expo-dev-client": "~58.0.19",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-notifications": "~58.1.9",
    "expo-secure-store": "~58.0.3",
    "expo-sharing": "~58.0.23",
    "expo-speech": "~58.0.4",
    "mongoose": "^9.12.1",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-animatable": "^1.4.0",
    "react-native-chart-kit": "~6.12.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "uuid": "^14.0.0",
    "victory-native": "~36.9.0",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/react-native": "^12.4.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "@types/uuid": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^6.10.0",
    "@typescript-eslint/parser": "^6.10.0",
    "babel-jest": "^29.7.0",
    "eslint": "^8.50.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "prettier": "^3.1.0",
    "typescript": "~6.0.3"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@react-native-voice/voice",
          "@react-native-ml-kit/text-recognition"
        ]
      }
    }
  }
}
